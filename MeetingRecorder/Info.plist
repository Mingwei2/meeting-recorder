<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>zh-Hans</string>
	<key>CFBundleDisplayName</key>
	<string>会议录音</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIconFile</key>
	<string></string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.utilities</string>
	<key>LSMinimumSystemVersion</key>
	<string>$(MACOSX_DEPLOYMENT_TARGET)</string>
	<key>LSUIElement</key>
	<true/>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
	<!-- Microphone prompt. System Settings → Privacy & Security → Microphone. -->
	<key>NSMicrophoneUsageDescription</key>
	<string>会议录音需要使用麦克风，以录下你在微信或会议中的发言。录音只保存在本机。</string>
	<!-- Screen Recording / Screen &amp; System Audio Recording. Required by ScreenCaptureKit, including audio-only capture. The app discards video frames. -->
	<key>NSScreenCaptureUsageDescription</key>
	<string>会议录音需要「屏幕录制」权限来采集所选应用的系统音频（例如微信里对方的声音）。正在共享的标记应只出现在这些应用的窗口上，菜单栏的录制指示可能仍会显示。本应用不保存屏幕画面，只把声音写进本机音频文件。</string>
	<!-- Purpose string if a newer macOS build shows a system-audio prompt. Capture itself uses ScreenCaptureKit, not a Core Audio process tap. -->
	<key>NSAudioCaptureUsageDescription</key>
	<string>会议录音需要采集系统音频，以录下微信或会议中对方的声音。录音只保存在本机。</string>
</dict>
</plist>
